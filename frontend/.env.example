# ==============================================================================
# EduBranch AI - Frontend Environment Configuration
# ==============================================================================
# RULE: NEVER store server secrets, API keys, or passwords in frontend env vars.
# Only public, frontend-safe values belong here.
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.
# ==============================================================================

# NestJS Backend API Gateway URL (frontend calls this — NEVER FastAPI directly)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Local dev only: show the "Dev quick-access" demo-account buttons on /login.
# Ignored in production builds. Leave unset (or false) to see the login page exactly as in Figma.
# VITE_ENABLE_DEV_LOGIN=true
