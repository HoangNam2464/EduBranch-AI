# ==============================================================================
# EduBranch AI - Backend Gateway Environment Configuration (NestJS + TypeScript)
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ==============================================================================

# Application
SERVER_PORT=8080
NODE_ENV=development

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edubranch_ai
POSTGRES_USER=edubranch
POSTGRES_PASSWORD=changeme_db_password
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# JWT Authentication
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_generate_a_strong_random_jwt_secret_min_64_chars
JWT_EXPIRES_IN=8h

# Internal AI Service (FastAPI)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=changeme_internal_ai_service_api_key

# MinIO Object Storage
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET_MATERIALS=edubranch-materials

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Challenge Support Governance
CHALLENGE_SUPPORT_MAX_ROUNDS=2
