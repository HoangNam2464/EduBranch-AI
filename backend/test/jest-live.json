{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.live-e2e\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": { "esModuleInterop": true, "allowSyntheticDefaultImports": true, "lib": ["es2022", "dom"] } }
    ]
  }
}
